# Copy this file to .env. Generate a password with `openssl rand -base64 32`,
# paste it below, and do not deploy with the example value.
MANA_ADMIN_PASSWORD=replace-with-a-unique-random-password

# Set to true only behind a trusted TLS-terminating reverse proxy that replaces
# X-Forwarded-Proto and X-Forwarded-For and prevents direct access to Mana's port.
MANA_ADMIN_TRUST_PROXY_HTTPS=false

# Required when proxy trust is enabled. Use only the exact proxy address ranges;
# Mana accepts one proxy-replaced client IP in X-Forwarded-For. The README's
# fixed-network example uses the host gateway 172.30.0.1/32.
MANA_ADMIN_TRUSTED_PROXY_CIDRS=
